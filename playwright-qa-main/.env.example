# Conduit RealWorld demo (BondarAcademy)
BASE_URL=https://conduit.bondaracademy.com
# Bare API origin — endpoint paths in api/endpoints.ts start with /api/...
API_URL=https://conduit-api.bondaracademy.com

# LocalStorage key used by the Angular SPA to read the JWT
# (confirmed by Phase 1 exploration; default to "jwt" — adjust if app reads differently)
JWT_LOCALSTORAGE_KEY=jwt